  "plots": {
    "enabled": false
  },
  "datasets": [
    {
      "key": "synthetic",
      "title": "SYNTHETIC SOFTWARE DEMO ONLY",
      "source": {
        "type": "table",
        "path": "synthetic_demo.csv"
      },
      "sample_id_column": "Sample_ID",
      "label_column": "True_Class",
      "feature_columns": [
        "Feature_1",
        "Feature_2",
        "Feature_3",
        "Feature_4"
      ]
    }
  ]
}
