{
  "output_root": "synthetic_results",
  "random_seed": 20261009,
  "algorithms": [
    "LDA",
    "SVM"
  ],
  "validation": {
    "outer_folds": 5,
    "inner_folds": 4
  },
  "preprocessing": {
    "missing": "error",
    "scale": "standard",
    "select_k": null,
    "pca_components": null
  },
